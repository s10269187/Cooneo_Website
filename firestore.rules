// ==========================================================
// COONEO 酷牛 — FIRESTORE SECURITY RULES
// ----------------------------------------------------------
// Paste this into Firebase console → Firestore Database → Rules → Publish.
//
// What it allows:
//   users/{uid}              → only that logged-in user can read/write their profile
//   users/{uid}/cart/...     → only that user (their saved cart)
//   users/{uid}/favourites/… → only that user (their saved favourites)
//   orders/{orderId}         → a logged-in user can CREATE an order for themselves
//                              (status must start as "pending_price_confirmation")
//                              and READ their own orders. Customers cannot edit or
//                              delete orders — customer service changes the status
//                              in the Firebase console.
// Everything else is blocked.
// ==========================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Is the person making the request logged in as this user?
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Profile document, plus the cart and favourites sub-collections under it
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{subCollection}/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Orders
    match /orders/{orderId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "pending_price_confirmation"
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;

      allow read: if request.auth != null && resource.data.uid == request.auth.uid;

      allow update, delete: if false;
    }
  }
}
